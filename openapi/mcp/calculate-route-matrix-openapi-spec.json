          "sources_to_targets": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "distance",
                  "time",
                  "source_index",
                  "target_index"
                ],
                "properties": {
                  "distance": {
                    "type": [
                      "number",
