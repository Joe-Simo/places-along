# Copy to .env.local. Both keys are optional: without them the app runs in sample mode.

# Geoapify API key (https://myprojects.geoapify.com/). Read from the environment only.
# Without it, both paths answer from bundled sample data, clearly labeled.
GEOAPIFY_API_KEY=

# OpenRouter key for the agent's model. Without it, the agent path follows a scripted plan
# with the same MCP tools.
OPENROUTER_API_KEY=

# Optional: comma-separated OpenRouter model ids, first is primary.
# PLACES_ALONG_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free

# Optional: live runs allowed per server instance per day (protects free quotas). Default 60.
# PLACES_ALONG_DAILY_LIVE_RUNS=60
