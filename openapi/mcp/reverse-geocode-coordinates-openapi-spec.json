  "info": {
    "title": "Geoapify MCP Tool: Geocoding: Reverse Geocode Coordinates",
    "version": "1.1.2",
    "description": "AI-focused, tool-specific OpenAPI specification for reverse_geocode_coordinates over the Geoapify JSON-RPC transport. Import this specification when an integration needs this tool without the full MCP catalog.",
    "contact": {
      "name": "Geoapify",
