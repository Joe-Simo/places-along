                    ]
                  },
                  "time": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "source_index": {
                    "type": "integer"
                  },
                  "target_index": {
                    "type": "integer"
                  }
                }
              }
            },
            "description": "Rows correspond to sources and columns correspond to targets."
          },
          "units": {
            "type": "string",
            "enum": [
              "metric",
              "imperial"
